{
  "name": "gymbooking-backend-cloudflare",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 execute gymbooking-db --local --file=./schema.sql",
    "db:migrate:remote": "wrangler d1 execute gymbooking-db --remote --file=./schema.sql",
    "db:seed:local": "wrangler d1 execute gymbooking-db --local --file=./seed.sql",
    "db:seed:remote": "wrangler d1 execute gymbooking-db --remote --file=./seed.sql"
  },
  "dependencies": {
    "hono": "^4.5.0"
  },
  "devDependencies": {
    "wrangler": "^3.78.0"
  }
}
